#!/usr/bin/env bash
# Delphi pre-commit hook — clippy lint gate on staged Rust crates.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks
#
# Scoped to the crates that actually have staged .rs changes, so the hook stays
# fast (whole-workspace clippy on every commit would just get --no-verify'd).
# Honors .cargo/config.toml's target-dir.
#
# NOTE — there is intentionally NO `cargo fmt --check` gate yet. The workspace is
# not rustfmt-clean (76/101 files diverge from rustfmt defaults; no rustfmt.toml).
# That is a tracked, deferred honest-record item (the WS-5 family). rustfmt will
# be adopted as its OWN isolated `style(workspace)` commit (with a pinned
# rustfmt.toml + .git-blame-ignore-revs), deliberately, NOT as a side-effect of an
# unrelated change. The fmt gate is added to this hook at that time.
set -euo pipefail

staged_rs="$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')"
if [ -z "$staged_rs" ]; then
    exit 0
fi

# Map each staged .rs file to its owning crate (nearest ancestor Cargo.toml),
# then run clippy per affected crate via --manifest-path. -D warnings is the gate.
declare -A manifests
while IFS= read -r f; do
    [ -z "$f" ] && continue
    d="$(dirname "$f")"
    while [ "$d" != "." ] && [ "$d" != "/" ]; do
        if [ -f "$d/Cargo.toml" ]; then
            manifests["$d/Cargo.toml"]=1
            break
        fi
        d="$(dirname "$d")"
    done
done <<< "$staged_rs"

for m in "${!manifests[@]}"; do
    echo "[pre-commit] cargo clippy --manifest-path $m --all-targets -- -D warnings"
    cargo clippy --manifest-path "$m" --all-targets -- -D warnings
done

# ── TEST GATE (added 2026-08-20; FIXED same day) ────────────────────────────────
# The first version did `grep 'test result:' | tail -1`, which reads ONE TARGET's line and
# calls it the run. That is precisely what §13.4 forbids, mechanised into the tool built
# to enforce §13.4 — and it would miss a red in any target whose line is not last.
#
# Fixed two ways: FAILURES ARE SUMMED ACROSS EVERY result line, and the executed/skipped
# figure comes from scripts/test-count.sh, which refuses to emit a bare total and
# subtracts skips (a skipped test is scored `ok` by libtest).
#
# The hook PRINTS WHAT IT VERIFIED so a commit message can quote it. Three figures were
# published today that were typed while composing the message rather than read from
# output — a number that can only come from the tool cannot be composed from memory.
# KNOWN GAP, recorded rather than left implicit: this gate is scoped to staged
# `runtime/` paths, so a change to THIS FILE skips it — hook edits are the one class that
# lands unchecked, and 1867b25 (the commit that fixed the gate's own `tail -1` defect) did
# exactly that. Defensible, since a hook cannot meaningfully gate its own edit without
# running the whole suite on every docs commit; but a gate with an exemption should say so.
#
# THREE MORE DEFECTS, FOUND WHEN THE REWRITTEN GATE FIRST RAN (2026-08-20). All three are
# the consequence of the exemption above: the fix for `tail -1` shipped unexecuted.
#   G1 it REFUSED EVERY COMMIT. `scripts/test-count.sh` exits non-zero whenever the suite has
#      any failure, and this branch has two intentional REDs; under `set -e` that killed the
#      hook before its own decision ran, so the gate blocked for a reason unrelated to the
#      commit. `|| true` belongs on the pipeline, and the DECISION belongs to the count.
#   G2 a suite that did not COMPILE would have passed. No `test result:` line means no
#      failures parsed, which is zero, which is under the threshold — `tail -1` wearing
#      different clothes. A run that produced no result line now REFUSES.
#   G3 `--no-fail-fast` is required for "summed across every result line" to be true: without
#      it cargo stops at the first failing target, so the bins' line never exists and the sum
#      is over the targets that ran, not all of them.
if git diff --cached --name-only | grep -qE '^runtime/'; then
    echo "[pre-commit] runtime test gate"
    # `--tests`, NOT `--lib --bins` (D0A-R14-03). The narrower scope excluded every
    # INTEGRATION suite, and two of them were red when round 14 looked: a fixture broken by
    # the nested-shebang rejection, and one hand-building an action production cannot. The
    # gate reported green through both. The full run costs ~3 seconds — the scope was never
    # justified by time, only by not having measured it.
    out=$(cargo test --no-fail-fast -p delphi-runtime --tests -- --test-threads=1 2>&1) || true
    result_lines=$(printf '%s\n' "$out" | grep -cE '^test result:' || true)
    total_failed=0
    while read -r n; do total_failed=$((total_failed + n)); done < <(
        printf '%s\n' "$out" | sed -n 's/^test result:.* \([0-9]\+\) failed.*/\1/p'
    )
    printf '%s\n' "$out" | grep -E '^test result:' | sed 's/^/[pre-commit]   /' || true
    counts=$(scripts/test-count.sh -p delphi-runtime --tests 2>/dev/null || true)
    printf '%s\n' "$counts" | grep -E '^EXECUTED' | sed 's/^/[pre-commit]   /' || true
    echo "[pre-commit]   result lines: $result_lines   FAILED across all targets: $total_failed"

    # A run that produced NO result line did not run at all — a compile error yields zero
    # `test result:` lines and therefore a failure count of zero, which would otherwise pass
    # every check below. This is first because everything after it reads those results.
    if [ "$result_lines" -eq 0 ]; then
        echo "REFUSING: no 'test result:' line — the suite did not RUN (compile error?)." >&2
        printf '%s\n' "$out" | tail -15 >&2
        exit 1
    fi

    # IDENTITY **AND** COUNT (D0A-R11-02, and its own first fix). Counting alone allowed a
    # red/green identity SWAP. Identity alone allowed a THIRD failure whenever the failures
    # block and the result line disagreed — measured against this hook's own test suite. The
    # expected set is data, in the baseline file, so there is ONE place to update and a green
    # suite is expressible (no RED= lines means no failure is tolerated).
    baseline="${DELPHI_TEST_COUNT_BASELINE:-.githooks/runtime-test-count-baseline}"
    if [ ! -r "$baseline" ]; then
        echo "REFUSING: no baseline at $baseline — the expected failures and counts would be UNGATED." >&2
        echo "  An absent guard that exits 0 is the shape this gate exists to catch." >&2
        exit 1
    fi
    expected_reds=$(sed -n 's/^RED=\(.*\)$/\1/p' "$baseline" | sort -u)
    expected_n=$(printf '%s' "$expected_reds" | grep -c . || true)
    actual_reds=$(awk '
        /^failures:$/ { inblock = 1; next }
        inblock && /^    [A-Za-z0-9_:]+$/ { gsub(/^ +/, ""); print; next }
        inblock { inblock = 0 }
    ' <<< "$out" | sort -u)
    if [ "$actual_reds" != "$expected_reds" ]; then
        echo "REFUSING: the failing tests are not the ones $baseline records." >&2
        echo "  expected:" >&2; printf '%s\n' "${expected_reds:-<none>}" | sed 's/^/    /' >&2
        echo "  actual:" >&2;   printf '%s\n' "${actual_reds:-<none>}" | sed 's/^/    /' >&2
        echo "  A count alone would have passed a red/green identity swap." >&2
        exit 1
    fi
    if [ "$total_failed" -ne "$expected_n" ]; then
        echo "REFUSING: $total_failed failure(s) reported but $expected_n recorded in $baseline." >&2
        echo "  The failures block and the result lines disagree — identity alone would have" >&2
        echo "  passed this, which is how a third failure hid behind two expected names." >&2
        exit 1
    fi

    # ── DISAPPEARANCE GATE (2026-08-20; fail-closed per D0A-R11-02) ────────────────
    # Counting FAILURES cannot see a test that is no longer there. `f380085` deleted two
    # tests in a commit that described neither, and the loss surfaced five commits later as
    # a property nothing covered. Equality on BOTH numbers, per the baseline file — and a
    # MISSING baseline REFUSES, because an absent guard that exits 0 is the exact shape
    # this gate exists to catch.
    got_exec=$(printf '%s\n' "$counts" | grep -oE '^EXECUTED [0-9]+' | grep -oE '[0-9]+' || true)
    got_skip=$(printf '%s\n' "$counts" | grep -oE 'SKIPPED [0-9]+' | grep -oE '[0-9]+' | head -1 || true)
    if [ -z "$got_exec" ] || [ -z "$got_skip" ]; then
        echo "REFUSING: could not measure the test counts — the count is UNKNOWN, not unchanged." >&2
        exit 1
    fi
    want_exec=$(sed -n 's/^EXECUTED=\([0-9]\+\)$/\1/p' "$baseline")
    want_skip=$(sed -n 's/^SKIPPED=\([0-9]\+\)$/\1/p' "$baseline")
    if [ -z "$want_exec" ] || [ -z "$want_skip" ]; then
        echo "REFUSING: $baseline carries no EXECUTED=/SKIPPED= pair to compare against." >&2
        exit 1
    fi
    if [ "$got_exec" != "$want_exec" ] || [ "$got_skip" != "$want_skip" ]; then
        echo "REFUSING: test counts differ from $baseline." >&2
        echo "  recorded: EXECUTED=$want_exec SKIPPED=$want_skip" >&2
        echo "  measured: EXECUTED=$got_exec SKIPPED=$got_skip" >&2
        echo "  If this is intended, update the baseline IN THIS COMMIT and say why." >&2
        echo "  A DROP in EXECUTED needs the test named: removed on purpose, or started skipping?" >&2
        exit 1
    fi
    echo "[pre-commit]   counts match $baseline (EXECUTED=$want_exec SKIPPED=$want_skip)"
    echo "[pre-commit]   failures match the $expected_n recorded in $baseline, by name"
fi
