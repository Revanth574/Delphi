# Root-lane counts for `-p delphi-runtime --tests`, ALL 17 targets under sudo.
#
# LANE RUN 12 — the FIRST run through `scripts/lane-run.sh`, and the first whose ordering is
# readable from evidence rather than from a commit message.
#
#   status=RAN_MATCH   expected 176/5   observed 176/5   producer_failures=0
#   extractor_rc=0     tree=0330b46     expectation_commit=c16c3e9
#
# THE EXPECTATION COMMIT IS THREE COMMITS BEHIND THE TREE, and the artifact records both.
# That is the property the protocol asserted from R21-07 onward and could not demonstrate:
# a reader who was not present can now check that the prediction predates the measurement,
# because the runner read a COMMITTED blob it could not have written and bound the pair into
# one artifact. The three commits between are runner fixes; none touched a Rust test, which
# is what the derivation predicted and why the figure holding is informative rather than
# merely unchanged.
#
# Artifact (outside the repository, so it does not change the tree it names):
#   ~/.local/state/delphi/lane-artifacts/lane-20260902T174359Z-0330b46.txt
#
# NOT COMPARABLE TO THE UNPRIVILEGED PAIR BY SUBSET. Three of the five skips skip BECAUSE
# the run is privileged and execute unprivileged, so 176 and 156 are overlapping sets and
# neither contains the other.
EXECUTED=176
SKIPPED=5
